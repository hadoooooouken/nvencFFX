+                                        let text_color = if resp.hovered() {
+                                            colors::TEXT_COLOR_B
+                                        } else {
+                                            colors::LABEL_TEXT
+                                        };
+                                        paint_clipped_text(ui, row, 28.0, &item.name, text_color);
+
+                                        if resp.clicked() {
+                                            picked = Some(item.id.clone());
+                                            ui.close();
+                                        }
+                                    }
+                                }
+                            }
+                        });
+                }
+            });
+    }
+
+    if let Some(v) = picked {
+        *selected_id = v;
+        response.mark_changed();
+    }
+    response
