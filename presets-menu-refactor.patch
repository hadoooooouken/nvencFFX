+                                                colors::ACCENT_GREEN,
+                                            );
+                                        } else if is_selected {
+                                            ui.painter().rect_filled(
+                                                row,
+                                                CornerRadius::same(4),
+                                                colors::SECONDARY_BG,
+                                            );
+                                        }
